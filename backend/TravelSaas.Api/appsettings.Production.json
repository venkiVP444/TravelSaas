{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "__SET_VIA_ENV_VAR_CONNECTIONSTRINGS__DEFAULTCONNECTION__"
  },
  "Jwt": {
    "Secret": "__SET_VIA_ENV_VAR_JWT__SECRET__",
    "Issuer": "https://api.v4journey.com",
    "Audience": "https://app.v4journey.com",
    "ExpiryDays": 7
  },
  "Storage": {
    "Provider": "S3",
    "S3": {
      "Endpoint": "__SET_VIA_ENV_VAR_STORAGE__S3__ENDPOINT__",
      "Bucket": "__SET_VIA_ENV_VAR_STORAGE__S3__BUCKET__",
      "PublicUrl": "__SET_VIA_ENV_VAR_STORAGE__S3__PUBLICURL__",
      "AccessKey": "__SET_VIA_ENV_VAR_STORAGE__S3__ACCESSKEY__",
      "SecretKey": "__SET_VIA_ENV_VAR_STORAGE__S3__SECRETKEY__"
    }
  },
  "Cors": {
    "AllowedOrigins": "https://app.v4journey.com;https://v4journey.com"
  }
}

