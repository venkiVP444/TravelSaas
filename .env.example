# ==============================================================================
# TRAVELSAAS (V4JOURNEY) PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or inject these variables into your container / cloud host.
# NEVER commit raw production secrets to source control.

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000;https://+:5001

# Database Provider (Must be PostgreSQL in production)
DatabaseProvider=PostgreSQL

# PostgreSQL Production Connection String
# Format: Host=<host>;Port=<port>;Database=<dbname>;Username=<user>;Password=<password>;Pooling=true;MinPoolSize=5;MaxPoolSize=100;SSL Mode=Require;Trust Server Certificate=true;
ConnectionStrings__DefaultConnection=Host=postgres.internal;Port=5432;Database=travelsaas_prod;Username=travelsaas_admin;Password=YourComplexPasswordHere_ChangeMe_2026;Pooling=true;MinPoolSize=5;MaxPoolSize=100;SSL Mode=Require;Trust Server Certificate=true;

# JWT Authentication Secrets (Must be at least 32 characters, high entropy)
Jwt__Secret=Production_High_Entropy_Secret_Key_TravelSaas_V4Journey_2026_Secure_Key_!@#$
Jwt__Issuer=https://api.v4journey.com
Jwt__Audience=https://app.v4journey.com
Jwt__ExpiryDays=7

# Object / Blob Storage (S3 / Cloudflare R2 / AWS S3 / MinIO)
Storage__Provider=S3
Storage__S3__Endpoint=https://s3.ap-south-1.amazonaws.com
Storage__S3__Bucket=v4journey-saas-media-prod
Storage__S3__PublicUrl=https://assets.v4journey.com
Storage__S3__AccessKey=AKIA_YOUR_S3_ACCESS_KEY
Storage__S3__SecretKey=YOUR_S3_SECRET_KEY_NEVER_SHARE

# Allowed CORS Origins (Semicolon-separated)
Cors__AllowedOrigins=https://app.v4journey.com;https://v4journey.com

